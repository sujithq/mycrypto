{
  "name": "mycrypto",
  "version": "1.0.0",
  "description": "A GitHub Pages dashboard for tracking a configurable €500 crypto portfolio.",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:manage": "node scripts/build.mjs --include-management",
    "daily-gems-issue": "node scripts/generate-daily-gems-issue.mjs",
    "publish-daily-gems-issue": "node scripts/upsert-daily-gems-issue.mjs",
    "diamond-quantities": "node .github/skills/diamond-quantities/scripts/rank-diamond-quantities.mjs",
    "test": "node --test",
    "market-quantity": "node .github/skills/market-quantity/scripts/calculate-market-quantity.mjs",
    "top-ath-quantities": "node .github/skills/top-ath-quantities/scripts/rank-ath-quantities.mjs",
    "supported-asset-entry": "node .github/skills/supported-asset-entry/scripts/resolve-supported-asset.mjs",
    "validate-profile": "node .github/skills/profile-validator/scripts/validate-profile.mjs",
    "update-data": "node scripts/update-market-data.mjs",
    "update-data:force": "node scripts/update-market-data.mjs --force",
    "check": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sujithq/mycrypto.git"
  },
  "keywords": [
    "crypto",
    "portfolio",
    "github-pages"
  ],
  "author": "Sujith Quintelier",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
